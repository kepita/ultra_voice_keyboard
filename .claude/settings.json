{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Todoist__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/todoist_keyboard_section.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__Todoist__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/todoist_keyboard_section.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
